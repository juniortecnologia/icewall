[Unit]
Description=ICEWALL, painel do DGX Spark (127.0.0.1:4310)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/ICEWALL
# O Node vem do nvm: ao trocar de versão, ajuste este PATH e rode systemctl --user daemon-reload.
Environment=PATH=%h/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=%h/.nvm/versions/node/v24.21.0/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 4310
Restart=on-failure
RestartSec=5
# O benchmark de perf segura o lock do delegate-local num processo filho: derruba o grupo inteiro ao parar.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
