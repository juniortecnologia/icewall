# Icewall - Variáveis de ambiente de exemplo
# Copie para .env.local e preencha os valores

# ===========================================
# SEGREDOS CRÍTICOS (obrigatórios)
# ===========================================

# JWT_SECRET: Chave para assinar tokens de sessão (HS256).
# Gere uma string aleatória segura (ex.: `openssl rand -base64 32`).
# MÍNIMO 32 caracteres. Nunca use o valor de exemplo em produção.
JWT_SECRET=

# ===========================================
# CONFIGURAÇÕES DE ADMIN (opcionais, têm defaults)
# ===========================================

# E-mail do administrador inicial (default: admin@icewall.ai)
ICEWALL_ADMIN_EMAIL=admin@icewall.ai

# Senha do administrador inicial (default: AdminPass123!)
# Altere em produção!
ICEWALL_ADMIN_PASSWORD=AdminPass123!

# ===========================================
# SPARK / SERVIDOR REMOTO (opcionais, têm defaults)
# ===========================================

# Host SSH do Spark (default: 10.0.5.18)
SPARK_SSH_HOST=10.0.5.18

# Usuário SSH do Spark (default: facini)
SPARK_SSH_USER=facini

# Porta SSH do Spark (default: 22)
SPARK_SSH_PORT=22

# Caminho da chave SSH privada para o Spark (opcional, se usar chave)
# SPARK_SSH_KEY_PATH=/caminho/para/chave_privada

# ===========================================
# BANCO DE DADOS (SQLite local - default)
# ===========================================

# Caminho do arquivo SQLite (default: data/icewall.db)
# DATABASE_PATH=data/icewall.db

# ===========================================
# OUTROS (opcionais)
# ===========================================

# Desabilitar scheduler em dev/teste (default: 0)
# ICEWALL_NO_SCHEDULER=0

# Porta do servidor Next.js (default: 4310)
# PORT=4310